# GitHub Linguist configuration
#
# The repository contains large ASP (.lp) benchmark instances.
# These are input data rather than algorithm implementations and
# are excluded from GitHub's language statistics.
# Actual ASP implementations and Python source code remain counted.

*.lp linguist-detectable=false

Experiments/monolithic-clingo/**/*.lp linguist-detectable=true
PreProcessing/**/*.lp linguist-detectable=true

Experiments/td-python/**/*.py linguist-language=Python
Experiments/td-python/**/*.py linguist-detectable=true
